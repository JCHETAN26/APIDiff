{
  "name": "APIDiff",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client && npm --prefix web/dashboard ci",
  "forwardPorts": [5173, 8080, 8081, 8082, 9090, 9091, 5432],
  "portsAttributes": {
    "5173": {
      "label": "Dashboard",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "API"
    },
    "8081": {
      "label": "Replay health"
    },
    "8082": {
      "label": "Analysis health"
    },
    "5432": {
      "label": "Postgres"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "golang.go",
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
